#!/usr/bin/env bash
set -uo pipefail

args=("$@")
if [ "${args[0]:-}" = "--region" ]; then
  args=("${args[@]:2}")
fi
cmd="${args[*]}"

case "$cmd" in
  "iam compartment list --access-level ANY --limit 1 --query "*)
    printf '%s\n' 'ocid1.tenancy.oc1..test'
    ;;
  "iam compartment get --compartment-id ocid1.compartment.oc1..test "*)
    printf '%s\n' 'VCN'
    ;;
  "bv volume list --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":[{"display-name":"data-volume","kms-key-id":"ocid1.key.oc1..data"}]}'
    ;;
  "iam availability-domain list --compartment-id ocid1.compartment.oc1..test")
    printf '%s\n' '{"data":[{"name":"AD-1"}]}'
    ;;
  "bv boot-volume list --compartment-id ocid1.compartment.oc1..test --availability-domain AD-1 --all")
    printf '%s\n' '{"data":[{"display-name":"boot-volume","kms-key-id":null}]}'
    ;;
  "os ns get --query data --raw-output")
    printf '%s\n' 'testns'
    ;;
  "os bucket list --compartment-id ocid1.compartment.oc1..test --namespace-name testns --all")
    printf '%s\n' '{"data":[{"name":"audit-bucket"}]}'
    ;;
  "os bucket get --bucket-name audit-bucket --namespace-name testns")
    printf '%s\n' '{"data":{"name":"audit-bucket","kms-key-id":"ocid1.key.oc1..data"}}'
    ;;
  "fs file-system list --compartment-id ocid1.compartment.oc1..test --availability-domain AD-1 --all")
    printf '%s\n' '{"data":[{"display-name":"shared-files","kms-key-id":"ocid1.key.oc1..data"}]}'
    ;;
  "db autonomous-database list --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":[{"db-name":"ADB1","kms-key-id":"ocid1.key.oc1..data","kms-key-version-id":"ocid1.keyversion.oc1..v2"},{"db-name":"ADB-EXTERNAL","encryption-key":{"provider":"AWS"}},{"db-name":"ADB-OKV","key-store-id":"ocid1.keystore.oc1..okv1"},{"db-name":"ADB-ORACLE","encryption-key":{"provider":"ORACLE_MANAGED"}},{"db-name":"ADB-SILENT"}]}'
    ;;
  "db system list --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":[{"id":"ocid1.dbsystem.oc1..db1","display-name":"base-db"}]}'
    ;;
  "db database list --compartment-id ocid1.compartment.oc1..test --db-system-id ocid1.dbsystem.oc1..db1 --all")
    printf '%s\n' '{"data":[{"db-name":"ORCL","kms-key-id":"ocid1.key.oc1..data"},{"db-name":"ORCLOKV","key-store-id":"ocid1.keystore.oc1..okv"},{"db-name":"ORCLEXT","encryption-key-location-details":{"provider-type":"AZURE"}},{"db-name":"ORCLPLAIN"}]}'
    ;;
  "mysql db-system list --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":[{"id":"ocid1.mysqldbsystem.oc1..mysql1"}]}'
    ;;
  "mysql db-system get --db-system-id ocid1.mysqldbsystem.oc1..mysql1")
    printf '%s\n' '{"data":{"display-name":"mysql1","encrypt-data":{"key-generation-type":"BYOK","key-id":"ocid1.key.oc1..data"}}}'
    ;;
  "psql db-system-collection list-db-systems --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":{"items":[{"id":"ocid1.postgresqldbsystem.oc1..pg1"}]}}'
    ;;
  "psql db-system get --db-system-id ocid1.postgresqldbsystem.oc1..pg1")
    printf '%s\n' '{"data":{"display-name":"postgres1","storage-details":{"system-type":"OCI_OPTIMIZED_STORAGE"}}}'
    ;;
  "kms vault list --compartment-id ocid1.compartment.oc1..test --all")
    printf '%s\n' '{"data":[{"id":"ocid1.vault.oc1..vault1","display-name":"ocs-vault","vault-type":"VIRTUAL_PRIVATE","lifecycle-state":"ACTIVE","management-endpoint":"https://vault-1-management.kms.us-langley-1.oraclecloud.com"}]}'
    ;;
  "kms management key list --endpoint https://vault-1-management.kms.us-langley-1.oraclecloud.com --compartment-id ocid1.compartment.oc1..test --all")
    if [ "${MOCK_DENY_KEY_LIST:-0}" = "1" ]; then
      echo 'ServiceError: Authorization failed. status: 403' >&2
      exit 1
    fi
    printf '%s\n' '{"data":[{"id":"ocid1.key.oc1..data","display-name":"ocs-data-key"}]}'
    ;;
  "kms management key get --endpoint https://vault-1-management.kms.us-langley-1.oraclecloud.com --key-id ocid1.key.oc1..data")
    if [ "${MOCK_ROTATION_FAILED:-0}" = "1" ]; then
      rotation_status='FAILED'
    else
      rotation_status='SUCCESS'
    fi
    printf '%s\n' "{\"data\":{\"id\":\"ocid1.key.oc1..data\",\"display-name\":\"ocs-data-key\",\"protection-mode\":\"HSM\",\"lifecycle-state\":\"ENABLED\",\"key-shape\":{\"algorithm\":\"AES\",\"length\":32},\"is-auto-rotation-enabled\":true,\"auto-key-rotation-details\":{\"rotation-interval-in-days\":90,\"time-of-schedule-start\":\"2026-03-01T00:00:00Z\",\"time-of-last-rotation\":\"2026-06-01T00:00:00Z\",\"time-of-next-rotation\":\"2026-08-30T00:00:00Z\",\"last-rotation-status\":\"$rotation_status\",\"last-rotation-message\":\"rotation completed\"}}}"
    ;;
  "kms management key-version list --endpoint https://vault-1-management.kms.us-langley-1.oraclecloud.com --key-id ocid1.key.oc1..data --all")
    printf '%s\n' '{"data":[{"id":"ocid1.keyversion.oc1..v1","time-created":"2026-03-01T00:00:00Z","lifecycle-state":"ENABLED","is-auto-rotated":false},{"id":"ocid1.keyversion.oc1..v2","time-created":"2026-06-01T00:00:00Z","lifecycle-state":"ENABLED","is-auto-rotated":true}]}'
    ;;
  *)
    echo "mock-oci-task3: unsupported command: $cmd" >&2
    exit 64
    ;;
esac
